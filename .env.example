# MentorLagbe server — environment variables
# Copy to .env and fill in real values. Never commit .env.

# Port for local development (Vercel sets its own)
PORT=5000

# MongoDB Atlas connection string (database name `mentorlagbe` is used in code)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<db>?retryWrites=true&w=majority

# Shared BetterAuth secret — MUST match the client's BETTER_AUTH_SECRET
BETTER_AUTH_SECRET=your-better-auth-secret

# Client origin (used for CORS and Stripe redirect URLs)
CLIENT_URL=https://assignment09-mentorlagbe-client.vercel.app

# Stripe (TEST mode) — leave empty until keys are available; checkout
# endpoints return a clean 503 while STRIPE_SECRET_KEY is unset.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
